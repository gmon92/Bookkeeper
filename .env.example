# The Docker app is published only on this computer's loopback interface.
BOOKKEEPER_PORT=8766

# Docker data folder. The default is ./bookkeeper-data beside compose.yaml.
# Set this to another absolute folder if you prefer.
# Windows example: C:/BookkeeperData
# Linux example: /home/your-name/bookkeeper-data
BOOKKEEPER_DATA_DIR=./bookkeeper-data
